environment {
    LIBVA_DRIVER_NAME                   "iHD"
    VDPAU_DRIVER                        "va_gl"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    _JAVA_AWT_WM_NONREPARENTING         "1"
    TERMINAL                            "alacritty"
    EDITOR                              "nvim"
}

include "layout.kdl"
include "key_binds.kdl"
include "window_rules.kdl"
include "input.kdl"
include "autostart.kdl"

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

output "eDP-1" {
  mode "1920x1080@60.008"
  scale 1.2
  transform "normal"
  position x=1280 y=0
}

hotkey-overlay {
  skip-at-startup
}

animations {
  on
}

debug {
  honor-xdg-activation-with-invalid-serial
}

gestures {
  hot-corners {
    off
  }
}

overview {
  // backdrop-color "#26233a"
  workspace-shadow {
    off
  }
}
