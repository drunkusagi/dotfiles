{
  "git_panel": {
    "tree_view": true,
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
  },
  "which_key": {
    "delay_ms": null,
    "enabled": true,
  },
  "agent_buffer_font_size": 9.0,
  "agent_ui_font_size": 13.0,
  "icon_theme": "Catppuccin Mocha",
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
    },
  },
  "vim_mode": true,
  "tab_size": 2,
  "ui_font_size": 13.0,
  "buffer_font_size": 14.0,
  "buffer_font_weight": 700.0,
  "buffer_font_family": "ZedMono Nerd Font",
  "ui_font_family": "ZedMono Nerd Font",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "scroll_beyond_last_line": "off",
  "scrollbar": {
    "show": "never",
  },
  "confirm_quit": true,
  "features": {
    "edit_prediction_provider": "zed",
    "experimental_edit_prediction_context_retrieval": true,
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Mocha",
  },
  "terminal": {
    "font_size": 12.0,
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/zsh",
        "args": ["-l"],
      },
    },
    "copy_on_select": true,
  },
  "project_panel": {
    "button": false,
    "default_width": 220,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 10.0,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": "never",
    },
  },
  "outline_panel": {
    "button": true,
    "default_width": 220,
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 8.0,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
  },
}
