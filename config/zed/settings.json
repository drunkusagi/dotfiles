{
  "icon_theme": "Catppuccin Mocha",
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
  },
  "vim_mode": true,
  "tab_size": 2,
  "ui_font_size": 18,
  "buffer_font_size": 16,
  "buffer_font_weight": 700.0,
  "buffer_font_family": "ZedMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "cursor_blink": false,
  "relative_line_numbers": true,
  "scroll_beyond_last_line": "off",
  "scrollbar": {
    "show": "never"
  },
  "confirm_quit": true,
  "features": {
    "edit_prediction_provider": "copilot",
    "copilot": true
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Mocha"
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/zsh",
        "args": ["-l"]
      }
    },
    "copy_on_select": true
  },
  "project_panel": {
    "button": false,
    "default_width": 220,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 10,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": "never"
    }
  },
  "outline_panel": {
    "button": true,
    "default_width": 220,
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 10,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true
  },
  "idle": {
    "timeout": 900,
    "state": "Zzz...",
    "details": "In Zed",
    "action": "change_activity"
  }
}
