zi light zsh-users/zsh-autosuggestions
zi light zsh-users/zsh-syntax-highlighting
zi light jeffreytse/zsh-vi-mode
zi light Aloxaf/fzf-tab

# ohmyzsh
zi snippet OMZL::git.zsh
zi snippet OMZL::completion.zsh
zi snippet OMZL::history.zsh
zi snippet OMZL::key-bindings.zsh
zi snippet OMZL::async_prompt.zsh
zi snippet OMZL::spectrum.zsh
zi snippet OMZL::theme-and-appearance.zsh
zi snippet OMZL::clipboard.zsh
zi snippet OMZL::functions.zsh
zi snippet OMZL::termsupport.zsh
zi snippet OMZL::spectrum.zsh
zi snippet OMZL::directories.zsh
zi snippet OMZP::git

# prompt theme
zi cdclear -q
setopt promptsubst
host_color="green"
user_color="white"
zi snippet OMZT::fishy

(( $+commands[fzf] ))     && source <(fzf --zsh)
(( $+commands[zoxide] ))  && eval "$(zoxide init zsh)"

[ -x "$HOME/.functions.sh" ] && source "$HOME/.functions.sh"
[ -x "$HOME/.aliases.sh" ]   && source "$HOME/.aliases.sh"

[[ "$TERM_PROGRAM" == "tmux" || -z "$TERM_PROGRAM" ]] && {
  (( $+commands[fastfetch] )) && fastfetch
  (( $+commands[task] ))      && task due:today or due:tomorrow or due:2day list 2>/dev/null
} || true


