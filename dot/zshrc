ZELLIJ_AUTO_ATTACH=false
ZELLIJ_AUTO_EXIT=true

if [ -z "$ZELLIJ" ] && [ -z "$NVIM" ] && [ -z "$VSCODE_NONCE" ]; then
  if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
    zellij attach -c
  else
   local layout_dir="$HOME/.config/zellij/layouts"
    local choice
    local exit_code

    local layouts
    layouts=$(find "$layout_dir" -maxdepth 1 -name "*.kdl" -printf "Layout: %f\n" 2>/dev/null | sed 's/\.kdl$//')

    local sessions
    sessions=$(zellij list-sessions 2>/dev/null | grep "EXITED" | awk '{print "Resurrect: " $1}')

    choice=$(echo -e "${layouts}\n${sessions}" | grep -v '^$' | sed '$a no-zellij' | \
             gum filter --placeholder "Select Layout or Session to Resurrect..." --height 15)

    exit_code=$?

    if [ $exit_code -eq 0 ] && [ -n "$choice" ] && [[ "$choice" != "no-zellij" ]]; then
        if [[ "$choice" == Layout:* ]]; then
            local layout_name="${choice#Layout: }"
            exec zellij --layout "$layout_name"
        elif [[ "$choice" == Resurrect:* ]]; then
            local session_name="${choice#Resurrect: }"
            exec zellij attach "$session_name"
        fi
    else
      NO_ZELLIJ=true
    fi
  fi

  if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]] && [ -z "$NO_ZELLIJ" ]; then
    exit
  fi
fi

clear

export ZSH="$HOME/.oh-my-zsh"

plugins=(golang git)

ZSH_THEME="fishy"
[ -d "$ZSH" ] && source $ZSH/oh-my-zsh.sh || true

DATA_DIR=$([ -d "$XDG_DATA_HOME" ] && printf "$XDG_DATA_HOME" || printf "$HOME/.local/share")

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

if [ ! -d "$NVM_DIR" ]; then
  export NVM_DIR="$DATA_DIR/nvm"
  [ ! -d "$NVM_DIR" ] && mkdir -p "$NVM_DIR"
  [ -d "/usr/share/nvm" ] && {
    source /usr/share/nvm/nvm.sh
    source /usr/share/nvm/bash_completion
  }
fi

export GOPATH="$DATA_DIR/go"
export PATH=$PATH:$HOME/.local/bin:$GOPATH/bin:$HOME/.cargo/bin:~/.bun/bin:$HOME/Apps/android-studio-sdk/flutter-stable/bin
export MANPAGER='nvim +Man!'

# make sure if command is exists
(($+commands[fzf])) && source <(fzf --zsh) || true
(($+commands[zoxide])) && eval "$(zoxide init zsh)" || true
(($+commands[oh-my-posh])) && eval "$(oh-my-posh init zsh --config $HOME/.omp.json)" || true

# load functions and aliases
[ -x "$HOME/.functions.sh" ] && source "$HOME/.functions.sh" || true
[ -x "$HOME/.aliases.sh" ] && source "$HOME/.aliases.sh" || true
[ -d "$HOME/.venv" ] && source "$HOME/.venv/bin/activate" || true
