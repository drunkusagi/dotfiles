export ZELLIJ_AUTO_ATTACH=false
export ZELLIJ_AUTO_EXIT=true

export GUM_FILTER_PROMPT_FOREGROUND="#FFFFFF"
export GUM_FILTER_TEXT_FOREGROUND="#FFFFFF"
export GUM_FILTER_MATCH_FOREGROUND="#FFD700"
export GUM_FILTER_INDICATOR_FOREGROUND="#FFD700"
export GUM_FILTER_PLACEHOLDER_FOREGROUND="#AAAAAA"

export NPM_CONFIG_PREFIX="$HOME/.local"
export MANPAGER='nvim +Man!'

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
export GOPATH="$DATA_DIR/go"

export PATH="$HOME/.local/bin:\
$GOPATH/bin:\
$HOME/.bun/bin:\
$HOME/.cargo/bin:\
$HOME/.pub-cache/bin:\
$HOME/fvm/versions/stable/bin/cache/dart-sdk/bin:\
$HOME/fvm/versions/stable/bin:\
$PATH"

if (( $+commands[zellij] )) && [[ -z "$ZELLIJ" && -z "$NVIM" && -z "$VSCODE_NONCE" && -z "$SSH" ]]; then
  if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
    zellij attach -c
  else
    local layout_dir="$HOME/.config/zellij/layouts"
    local items=()

    while IFS= read -r f; do
      items+=("layout:${f:t:r}")
    done < <(find "$layout_dir" -maxdepth 1 -name "*.kdl" 2>/dev/null)

    while IFS= read -r s; do
      items+=("resurrect:$s")
    done < <(zellij list-sessions 2>/dev/null | awk '/EXITED/{print $1}')

    items+=("no-zellij")

    local choice
    choice=$(printf '%s\n' "${items[@]}" | gum filter --no-show-help --placeholder "zellij..." --height 15)
    local gum_status=$?

    if [[ $gum_status -eq 0 ]]; then
      if [[ "$choice" == "no-zellij" ]]; then
        return 0
      elif [[ "$choice" == layout:* ]]; then
        exec zellij --layout "${choice#layout:}"
      elif [[ "$choice" == resurrect:* ]]; then
        exec zellij attach "${choice#resurrect:}"
      fi
    fi
  fi
fi

clear

autoload -Uz compinit
compinit

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

